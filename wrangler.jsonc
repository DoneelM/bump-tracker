// Cloudflare Workers: static assets, plus a tiny Worker (worker/index.js) for /api/* only (the anonymous
// count). Workers Builds runs `npm test && npm run build`, then `npm run deploy` on every push to main. See docs/DEPLOY-NOTES.md.
{
  "name": "bump-tracker",
  "compatibility_date": "2026-09-25",
  "send_metrics": false,
  // Served at a subdomain of a domain we own: Google brand verification needs a verified domain, and it's the
  // app's own origin. aiagents.nz must be an active zone in the same Cloudflare account.
  "routes": [{ "pattern": "bump-tracker.aiagents.nz", "custom_domain": true }],
  // Keep branch preview URLs on. With routes set, Wrangler defaults workers.dev off, and a main deploy can then
  // switch preview URLs off too. workers_dev stays at its default (off): production lives only on the domain above.
  "preview_urls": true,
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    // Only the count endpoint runs code; every other request is served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  // The Analytics Engine binding for the anonymous count (PINGS) is added once Analytics Engine is switched on
  // in the Cloudflare account; deploys fail until then. Without it the Worker accepts pings and drops them.
  // Required by `wrangler preview`, which Workers Builds runs for non-main branches. Empty: previews use the
  // top-level settings (assets only; no vars or bindings). Preview URLs are their own origins, so Google sync
  // sign-in won't work there unless that origin is added to the OAuth client.
  "previews": {}
}
