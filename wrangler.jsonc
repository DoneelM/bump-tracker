// Cloudflare Workers (static assets only, no Worker script). Workers Builds runs `npm test && npm run build`,
// then `npm run deploy` on every push to main. See docs/DEPLOY-NOTES.md.
{
  "name": "bump-tracker",
  "compatibility_date": "2026-09-25",
  "send_metrics": false,
  // Served at the app's own domain: Google brand verification needs a verified domain, and it's the app's own
  // origin. heybaby.nz must be an active zone in the same Cloudflare account. www redirects to it (a Cloudflare
  // redirect rule), so there is only one origin and one copy of each user's data.
  "routes": [{ "pattern": "heybaby.nz", "custom_domain": true }],
  // Keep branch preview URLs on. With routes set, Wrangler defaults workers.dev off, and a main deploy can then
  // switch preview URLs off too. workers_dev stays at its default (off): production lives only on the domain above.
  "preview_urls": true,
  "assets": {
    "directory": "./dist"
  },
  // Required by `wrangler preview`, which Workers Builds runs for non-main branches. Empty: previews use the
  // top-level settings (assets only; no vars or bindings). Preview URLs are their own origins, so Google sync
  // sign-in won't work there unless that origin is added to the OAuth client.
  "previews": {}
}
